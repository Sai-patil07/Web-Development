<html>
<head>
<title>Formule</title>
</head>
<body bgcolor="pink">
<h1>Formule</h1>
<hr>
<ul>Maths Formule
<ol>
<li>(a+b)<sup>2</sup>=a<sup>2</sup>+b<sup>2</sup>+2ab</li>
<li>(a-b)<sup>2</sup>=a<sup>2</sup>+b<sup>2</sup>-2ab</li>
<li>a<sup>2</sup>+b<sup>2</sup>=(a+b)<sup>2</sup>-2ab</li>
<li>a<sup>2</sup>-b<sup>2</sup>=(a-b)(a+b)</li>
<li>a<sup>3</sup>+b<sup>3</sup>=(a+b)(a<sup>2</sup>-ab+b<sup>2</sup>)</li>
<li>a<sup>3</sup>-b<sup>3</sup>=(a-b)(a<sup>2</sup>+ab+b<sup>2</sup>)</li>
<li>(a+b)<sup>3</sup>=a<sup>3</sup>+3a<sup>2</sup>b+3ab<sup>2</sup>+b<sup>3</sup></li>
<li>(a-b)<sup>3</sup>=a<sup>3</sup>-3a<sup>2</sup>b+3ab<sup>2</sup>+b<sup>3</sup></li>
<li>a<sup>4</sup>-b<sup>4</sup>=(a-b)(a+b)(a<sup>2</sup>+b<sup>2</sup>)</li>
<li>a<sup>5</sup>-b<sup>5</sup>=(a-b)(a<sup>4</sup>+a<sup>3</sup>b+a<sup>2</sup>b<sup>2</sup>+ab<sup>3</sup>+b<sup>4</sup>)</li>
</ol>
</ul>
<ul>Physics Formule
<ol>
<li>(energy)E=mc<sup>2</sup></li>
<li>E<sub>k</sub>=1/2mv<sup>2</sup></li>
<li>(speed)S=ut+1/2at<sup>2</sup></li>
<li>v<sup>2</sup>=u<sup>2</sup>+2as</li>
<li>(power)P=I<sup>2</sup>R</li>
</ol>
</ul>
<ul>Chemistry Formule
<ol>
<li>Water=H<sub>2</sub>O</li>
<li>Glucose=C<sub>6</sub>H<sub>12</sub>O<sub>6</sub></li>
<li>Ammonia=NH<sub>3</sub></li>
<li>Sulfuric Acid=H<sub>2</sub>SO<sub>4</sub></li>
<li>Nitrogen=N<sub>2</sub>O</li>
</ol>
</ul>
</body>
</html>
